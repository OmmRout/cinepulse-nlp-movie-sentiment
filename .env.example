# Application Security & Runtime Configuration
FLASK_ENV=production
SECRET_KEY=replace-with-a-64-char-cryptographically-random-hex-string
PORT=5000

# Security Controls
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
RATELIMIT_STORAGE_URI=memory://
MAX_REVIEW_CHARS=10000
MAX_BATCH_ROWS=500
MAX_UPLOAD_BYTES=2097152

# Transformer Runtime (DistilBERT SST-2 ONNX)
TRANSFORMER_REPO_ID=Xenova/distilbert-base-uncased-finetuned-sst-2-english
TRANSFORMER_PRELOAD=true
